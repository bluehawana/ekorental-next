    "next": "^15.0.0",
    "node-mailjet": "^6.0.6",
    "prisma": "^6.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.1",
    "react-icons": "^5.0.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.17",
